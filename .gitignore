# 构建产物
/agentdesk
/bin/
*.test

# 评测每次运行的报告是可再生产物，只保留最新一份即可；
# 若要作为回归基线长期保存，请显式提交。
eval/reports/*.json

# 改造 v2 数据集时下载的第三方原始语料（Console-AI MIT / tasksource CC-BY，含 CSV/parquet）。
# 可凭 eval/datasets/gen_v2.py 里记录的 URL 重新下载，许可归原作者，不入仓。
eval/raw/

# Chainlit 前端：虚拟环境与字节码缓存是本地产物，体积大且含二进制，不入仓。
# 依赖清单见 ui/requirements.txt，重建只需 pip install -r ui/requirements.txt。
ui/.venv/
ui/__pycache__/

# 编辑器与系统
.DS_Store
.idea/
.vscode/
